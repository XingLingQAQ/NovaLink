# Root gitignore (repo-wide). Keep it minimal and safe.

# Gradle / Java
.gradle/
.gradle-agent-*/
**/build/
**/out/
**/.classpath
**/.project
**/.settings/
**/*.iml
**/*.ipr
**/*.iws

# IntelliJ / VSCode
.idea/
.vscode/

# Node / Vite
**/node_modules/
**/dist/
**/.vite/

# Go
**/*.exe
**/*.test
**/*.out

# Python
**/__pycache__/
**/*.pyc

# xmake
**/.xmake/

# Real-server E2E harness workspace (downloaded server jars, worlds, runtime logs/configs)
.e2e/
logs/


# Prevent runtime logs from being committed
*.log
novalink-core/logs/

# Agent / tooling working directories
.playwright-mcp/
.jqwik-database
.jqwik-database/
