# Root gitignore (repo-wide). Keep it minimal and safe.

# Gradle / Java
.gradle/
.gradle-agent-*/
**/build/
**/out/
**/.classpath
**/.project
**/.settings/
**/*.iml
**/*.ipr
**/*.iws

# Maven-style build output (some modules still produce target/ via legacy/shade steps)
target/
# maven-shade reduced POM artifact (regenerated on each build)
dependency-reduced-pom.xml

# ForgeGradle root-level extraction droppings (META-INF/, net/, _EMPTY_ can appear
# at the repo root when a NeoForge/Forge setup task unpacks into the working dir)
/META-INF/
/net/
/_EMPTY_

# IntelliJ / VSCode
.idea/
.vscode/

# Node / Vite
**/node_modules/
**/dist/
**/.vite/

# Go
**/*.exe
**/*.test
**/*.out

# Python
**/__pycache__/
**/*.pyc

# xmake
**/.xmake/
# xmake package download cache (local build pkg cache, not for repo)
.xmake-pkg-cache/

# Real-server E2E harness workspace (downloaded server jars, worlds, runtime logs/configs)
.e2e/
# Committed e2e/ harness runtime artifacts (CI downloads + per-run logs/worlds)
.e2e-artifacts/
logs/


# Prevent runtime logs from being committed
*.log
novalink-core/logs/

# Agent / tooling working directories
.playwright-mcp/
.jqwik-database
.jqwik-database/

# Dev/AI tool artifacts and intermediate audit docs (kept locally, excluded from git history)
.kiro/
规划.md
tmp-access-widener.jar
tmp-access-widener-fabric.jar
docs/superpowers/
docs/I18N-MIGRATION-AND-CODE-AUDIT-2026-08.md
docs/REVIEW-bugs.md
docs/REVIEW-coupling.md
docs/REVIEW-dup.md
docs/TEST-MATRIX-CODE.md
docs/UX-AUDIT-1.md
docs/UX-AUDIT-2.md
docs/UX-COPY-PROXY.md
docs/UX-COPY-SERVER.md
docs/UX-DESIGN-2.md
docs/UX-DESIGN.md
.cursor-handoff.full.md
package-lock.json

# Browser-test screenshots (generated by Camoufox/jshook verification runs)
screenshots/

# Gradle userHome cache (per-user build cache, not for repo)
.gradle-user/
